generator client {
  provider = "prisma-client-js"
}

generator clientApp {
  provider = "prisma-client-js"
  output   = "../../client/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AccountKind {
  USER
  DOCTOR
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum Gender {
  Male 
  Female
  LGBTQ
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  name                  String
  passwordHash          String?
  image                 String?
  emailVerified         Boolean   @default(false)
  role                  Role      @default(PATIENT)
  tokenVersion          Int       @default(0) // use to check if the refesh token that we sent is of same version or not 
  // if not then revoke the refresh token from all device 
  // it's good to check this before making new refresh token
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?

  age                   Int?
  gender                Gender?   @default(Female)

  identity              LoginIdentity?
  accounts              Account[]
  refreshTokens         RefreshToken[]
  appointments          Appointment[]
  reviews               Review[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([role])
}

model Doctor {
  id                    String    @id @default(uuid())
  email                 String    @unique
  name                  String
  passwordHash          String?
  image                 String?
  emailVerified         DateTime?
  role                  Role      @default(DOCTOR)
  tokenVersion          Int       @default(0)
  phone                 String?  

  licenseNumber         String?   @unique
  specialization        String?
  experience            Int?
  verified              Boolean   @default(false)
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?

  identity              LoginIdentity?
  accounts              DoctorAccount[]
  refreshTokens         RefreshToken[]
  appointments          Appointment[] 
  reviews               Review[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([role])
  @@index([verified])
}

model LoginIdentity {
  email     String      @id
  kind      AccountKind
  userId    String?     @unique
  doctorId  String?     @unique
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor    Doctor?     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([provider, providerAccountId])
  @@index([userId])
}

model DoctorAccount {
  doctorId          String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  doctor            Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([provider, providerAccountId])
  @@index([doctorId])
}

model RefreshToken {
  id         String      @id @default(uuid())
  tokenHash  String      @unique
  familyId   String
  kind       AccountKind
  userId     String?
  doctorId   String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor     Doctor?     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  ip         String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([doctorId])
  @@index([familyId])
  @@index([expiresAt])
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  patient         User              @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  scheduleID      String
  scheduledAt     Timeperiod        @relation(fields: [scheduleID], references: [id])
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([patientId])
  @@index([doctorId])
  // @@index([scheduledAt])
}

model Review {
  id        String   @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId] , references: [id] , onDelete: Cascade)
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  createdAt DateTime @default(now())

  @@index([doctorId])
}

model Timeperiod {
  id    String @id @default(uuid())
  from  String?
  to    String?
  appointment  Appointment[]
}
