generator client {
  provider = "prisma-client-js"
}

// Separate output so the Next.js app can import the same schema's client
// without reaching into the Express server's node_modules.
generator clientApp {
  provider = "prisma-client-js"
  output   = "../../client/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AccountKind {
  USER
  DOCTOR
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  name                  String
  passwordHash          String?
  image                 String?
  emailVerified         DateTime?
  role                  Role      @default(PATIENT)
  tokenVersion          Int       @default(0)
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?

  dateOfBirth           DateTime?
  gender                String?

  identity              LoginIdentity?
  accounts              Account[]
  refreshTokens         RefreshToken[]
  appointments          Appointment[] @relation("PatientAppointments")

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([role])
}

model Doctor {
  id                    String    @id @default(uuid())
  email                 String    @unique
  name                  String
  passwordHash          String?
  image                 String?
  emailVerified         DateTime?
  role                  Role      @default(DOCTOR)
  tokenVersion          Int       @default(0)
  phone                 String?

  licenseNumber         String?   @unique
  specialization        String?
  experience            Int?
  verified              Boolean   @default(false)
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?

  identity              LoginIdentity?
  accounts              DoctorAccount[]
  refreshTokens         RefreshToken[]
  appointments          Appointment[] @relation("DoctorAppointments")
  reviews               Review[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([role])
  @@index([verified])
}

// One email = one account, whether that account is a patient (User) or a doctor.
model LoginIdentity {
  email     String      @id
  kind      AccountKind
  userId    String?     @unique
  doctorId  String?     @unique
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor    Doctor?     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([provider, providerAccountId])
  @@index([userId])
}

model DoctorAccount {
  doctorId          String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  doctor            Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([provider, providerAccountId])
  @@index([doctorId])
}

model RefreshToken {
  id         String      @id @default(uuid())
  tokenHash  String      @unique
  familyId   String
  kind       AccountKind
  userId     String?
  doctorId   String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor     Doctor?     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ip         String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([doctorId])
  @@index([familyId])
  @@index([expiresAt])
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  patient         User              @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId        String
  doctor          Doctor            @relation("DoctorAppointments", fields: [doctorId], references: [id])
  scheduledAt     DateTime
  status          AppointmentStatus @default(PENDING)
  notes           String?
  prescriptionUrl String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
}

model Review {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())

  @@index([doctorId])
}
